    {
        "id": "88374f80eed7b030",
        "type": "function",
        "z": "bf90239b7de8735b",
        "name": "function 2",
        "func": "// GET event log from flow context\nlet motionEvents = flow.get(\"motion_events\") || [];\n\n// SET current time and window\nconst now = Date.now();\nconst windowMs = 10 * 60 * 1000; // 10 minutes in milliseconds\n\n// ADD current time to event log\nmotionEvents.push(now);\n\n// REMOVE events outside the time window\nmotionEvents = motionEvents.filter(t => (now - t) < windowMs);\n\n// SAVE updated event log back to flow context\nflow.set(\"motion_events\", motionEvents);\n\n// COUNT events\nconst eventCount = motionEvents.length;\n\n// CLASSIFY activity level\nlet level;\nif (eventCount === 0) {\n    level = \"idle\";\n} else if (eventCount <= 5) {\n    level = \"low\";\n} else if (eventCount <= 15) {\n    level = \"medium\";\n} else {\n    level = \"high\";\n}\n\n// SET message payload\nmsg.payload = {\n    level: level,\n    event_count: eventCount,\n    window_minutes: 10,\n    timestamp: new Date().toISOString()\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
