{
  "version": 1,
  "minor_version": 1,
  "key": "lovelace.iotlab_3",
  "data": {
    "config": {
      "views": [
        {
          "title": "Smartbin - Kypes Lab",
          "type": "sections",
          "max_columns": 3,
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "System Overview"
                },
                {
                  "type": "markdown",
                  "title": "Bin Capacity Load",
                  "content": "{% set count = states('sensor.smart_wastebin_01_motion_event_count') | int(0) %}\n{% if count == 0 %}\n  <ha-icon icon=\"mdi:delete-outline\" style=\"color: #9E9E9E;\"></ha-icon> **Current Load:** <span style=\"color: #9E9E9E;\">Idle (0 events)</span>\n\n{% elif count >= 1 and count <= 5 %}\n  <ha-icon icon=\"mdi:delete-variant\" style=\"color: #2196F3;\"></ha-icon> **Current Load:** <span style=\"color: #2196F3;\">Low ({{ count }} events)</span>\n\n{% elif count >= 6 and count <= 15 %}\n  <ha-icon icon=\"mdi:delete-empty\" style=\"color: #FFC107;\"></ha-icon> **Current Load:** <span style=\"color: #FFC107;\">Medium ({{ count }} events)</span>\n\n{% elif count >= 16 %}\n  <ha-icon icon=\"mdi:alert-decagram\" style=\"color: #F44336;\"></ha-icon> **Current Load:** <span style=\"color: #F44336;\">**HIGH - EMPTY BIN**</span>\n\n{% else %}\n  <ha-icon icon=\"mdi:delete\" style=\"color: grey;\"></ha-icon> **Current Load:** Unknown State\n{% endif %}"
                },
                {
                  "type": "gauge",
                  "entity": "sensor.smart_wastebin_01_motion_event_count",
                  "name": "Total Motion Events",
                  "min": 0,
                  "max": 25,
                  "needle": true,
                  "severity": {
                    "green": 0,
                    "yellow": 6,
                    "red": 16
                  }
                },
                {
                  "type": "history-graph",
                  "entities": [
                    {
                      "entity": "sensor.smart_wastebin_01_wastebin_status"
                    }
                  ],
                  "title": "Sensor status - Last 24 hours"
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Bin 01",
                  "heading_style": "title"
                },
                {
                  "type": "glance",
                  "entities": [
                    {
                      "entity": "binary_sensor.smartbin_bin_01_smartbin_bin_01_motion",
                      "name": "Live Motion"
                    },
                    {
                      "entity": "sensor.smart_wastebin_01_wastebin_status",
                      "name": "Sensor State"
                    }
                  ],
                  "state_color": true,
                  "show_state": true
                },
                {
                  "chart_type": "bar",
                  "period": "5minute",
                  "type": "statistics-graph",
                  "title": "Peak Usage (Last 2 Hours)",
                  "days_to_show": 0.083,
                  "stat_types": [
                    "change"
                  ],
                  "entities": [
                    {
                      "entity": "sensor.smart_wastebin_01_motion_event_count",
                      "name": "New Events"
                    }
                  ],
                  "max_y_axis": 20
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Activity Prediction"
                },
                {
                  "type": "entities",
                  "show_header_toggle": false,
                  "entities": [
                    {
                      "entity": "sensor.smart_wastebin_bin_01_activity_prediction",
                      "name": "ML Prediction Target",
                      "secondary_info": "last-changed",
                      "icon": "mdi:brain"
                    },
                    {
                      "entity": "sensor.smart_wastebin_bin_01_prediction_confidence",
                      "name": "Confidence Rating",
                      "icon": "mdi:chart-bell-curve-cumulative"
                    }
                  ]
                }
              ]
            }
          ],
          "cards": []
        }
      ]
    }
  }
}